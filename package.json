{
  "name": "wwm-discord-bot",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "src/main",
  "scripts": {
    "build": "bun build --target=bun --minify-whitespace --minify-syntax --sourcemap src/main.ts --outdir dist -e class-validator -e class-transformer -e @nestjs/microservices -e @nestjs/websockets -e @nestjs/platform-socket.io -e @fastify/static -e @fastify/view",
    "deploy": "nest deploy",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "xss-scan": "xss-scan"
  },
  "imports": {
    "#*": "./src/*"
  },
  "dependencies": {
    "@kitajs/html": "^4.2.13",
    "@necord/localization": "^5.0.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/schedule": "^12.0.4",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^1.0.0-rc.5-ab785fc",
    "hashids": "^2.3.0",
    "ms": "^2.1.3",
    "necord": "^7.1.1",
    "nestjs-platform-bun": "^0.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@kitajs/ts-html-plugin": "^4.1.4",
    "@necord/schematics": "^2.0.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/mau": "^0.2.9",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/bun": "^1.4.4",
    "@types/ms": "^2.1.0",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
